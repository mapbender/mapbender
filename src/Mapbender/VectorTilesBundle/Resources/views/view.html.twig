{# @var source \Mapbender\VectorTilesBundle\Entity\VectorTileSource #}
{% extends "@MapbenderManager/Repository/source/view.html.twig" %}
{%- import '@MapbenderManager/macros/tabs.html.twig' as tab_macros -%}

{% block layers_content %}
    <p>{{ 'mb.vectortiles.admin.layer_hint' | trans }}</p>
{% endblock %}

{% macro renderTable(items) %}
    <table>
        {% for key, value in items %}
            <tr>
                <th>{{ key }}:</th>
                <td>
                    {% if value is iterable %}
                        {{ _self.renderTable(value) }}
                    {% elseif value is same as(true) %}
                        true
                    {% elseif value is same as(false) %}
                        false
                    {% else %}
                        {{ value }}
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </table>
{% endmacro %}

{% block details_content %}
    {{ _self.renderTable(source.metadataArray) }}
{% endblock %}
